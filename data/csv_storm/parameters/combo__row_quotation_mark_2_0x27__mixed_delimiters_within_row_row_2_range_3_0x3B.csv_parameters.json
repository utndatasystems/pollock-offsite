{
    "encoding": "ascii",
    "delimiter": ",",
    "quotechar": "\"",
    "escapechar": "\"",
    "row_delimiter": "\r\n",
    "header_lines": 1,
    "preamble_lines": 0,
    "footnote_lines": 0,
    "column_names": [
        "DATE",
        "TIME",
        "Qty",
        "PRODUCTID",
        "Price",
        "ProductType",
        "ProductDescription",
        "URL",
        "Comments"
    ],
    "n_columns": 9,
    "combination": {
        "pollutions": [
            {
                "function": "changeRowQuotationMark",
                "name": "Row-Wise Quote Character Ambiguity",
                "category": "Dialect and Lexical-Syntax",
                "arguments": {
                    "row": 2,
                    "target_quotation": "'"
                }
            },
            {
                "function": "mixedDelimiters",
                "name": "Mixed Delimiters",
                "category": "Dialect and Lexical-Syntax",
                "arguments": {
                    "row": 2,
                    "delimiters": [
                        ";"
                    ],
                    "mode": "within_row",
                    "range_within_row": 3
                }
            }
        ]
    }
}