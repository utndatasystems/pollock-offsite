{"type": "generated_parser", "timestamp": "2026-11-24T17:14:21+00:00", "program": "import csv\nimport io\nimport re\n\n\nEXPECTED_WIDTH = 285\n\n\ndef parse_csv(raw_csv: str):\n    reader = csv.reader(\n        io.StringIO(raw_csv, newline=\"\"),\n        delimiter=\";\",\n        quotechar='\"',\n        doublequote=True,\n        strict=False,\n    )\n\n    records = []\n    try:\n        for row in reader:\n            if row:\n                records.append([value if isinstance(value, str) else str(value) for value in row])\n    except csv.Error:\n        pass\n\n    if not records:\n        return {\"columns\": [], \"rows\": []}\n\n    number = re.compile(r\"^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$\")\n    header_index = None\n\n    for index, row in enumerate(records):\n        if len(row) < max(1, EXPECTED_WIDTH - 2):\n            continue\n        populated = [value for value in row if value.strip()]\n        if not populated:\n            continue\n        nonnumeric = sum(\n            1 for value in populated\n            if not number.match(value.strip())\n        )\n        if nonnumeric / len(populated) >= 0.2:\n            header_index = index\n            break\n\n    if header_index is None:\n        header_index = next(\n            (i for i, row in enumerate(records) if len(row) == EXPECTED_WIDTH),\n            0,\n        )\n\n    columns = records[header_index][:EXPECTED_WIDTH]\n    if len(columns) < EXPECTED_WIDTH:\n        columns.extend([\"\"] * (EXPECTED_WIDTH - len(columns)))\n\n    rows = []\n    for row in records[header_index + 1:]:\n        if len(row) < EXPECTED_WIDTH:\n            row = row + [\"\"] * (EXPECTED_WIDTH - len(row))\n        elif len(row) > EXPECTED_WIDTH:\n            row = row[:EXPECTED_WIDTH - 1] + [\";\".join(row[EXPECTED_WIDTH - 1:])]\n        rows.append(row)\n\n    return {\"columns\": columns, \"rows\": rows}"}
