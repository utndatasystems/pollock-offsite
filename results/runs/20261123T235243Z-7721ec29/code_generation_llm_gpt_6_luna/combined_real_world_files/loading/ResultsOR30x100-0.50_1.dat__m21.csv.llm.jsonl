, name in enumerate(raw_columns):\n        base = name or \"column_{}\".format(index + 1)\n        used[base] = used.get(base, 0) + 1\n        columns.append(base if used[base] == 1 else \"{}_{}\".format(base, used[base]))\n\n    width = len(columns)\n    for record in data_records:\n        if len(record) > width:\n            for index in range(width, len(record)):\n                columns.append(\"column_{}\".format(index + 1))\n            width = len(columns)\n\n    rows = []\n    for record in data_records:\n        if len(record) < width:\n            record = record + [\"\"] * (width - len(record))\n        rows.append(record)\n\n    return {\"columns\": columns, \"rows\": rows}"}
